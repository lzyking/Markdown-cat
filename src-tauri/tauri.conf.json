{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Markdown Cat",
  "version": "0.2.5",
  "identifier": "com.markdowncat.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Markdown Cat",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 500,
        "center": true,
        "resizable": true,
        "transparent": false,
        "decorations": true,
        "fullscreen": false,
        "visible": true,
        "focus": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**/*", "$APPLOCALDATA/**/*"]
      },
      "csp": "default-src 'self'; connect-src 'self' ipc: localhost:* ws://localhost:* https: http:; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Markdown Cat Team",
    "copyright": "Copyright © 2026 Markdown Cat Team",
    "shortDescription": "A sleek and portable Markdown editor built with Tauri 2.x and Vue 3",
    "longDescription": "Markdown Cat is a modern, fast, and feature-rich Markdown editor with real-time preview, HTML/PDF export, and Confluence publishing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {}
}
