[
  {
    "identifier": "filesystem",
    "description": "Capability for file system access and folder picker. Scope limited to app data directory and user selected save directory (defined in Story 4.x).",
    "windows": ["main"],
    "permissions": [
      {
        "identifier": "fs:scope",
        "allow": [
          "$APPDATA/**/*",
          "$APPDATALOCAL/**/*"
        ]
      },
      "fs:allow-read-dir",
      "fs:allow-read-file",
      "fs:allow-write-file",
      "fs:allow-create",
      "fs:allow-exists",
      "fs:allow-mkdir",
      "dialog:allow-open"
    ],
    "platforms": ["macOS", "windows", "linux"]
  }
]
